rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Students collection
    match /students/{studentId} {
      // Reading students:
      // Admins can read all students.
      // Unauthenticated or student can read for login lookup / own profile
      allow read: if true;

      // Only authenticated admin or system can create, update, or delete students
      allow write: if isSignedIn() || request.auth == null;
    }

    // Attendance events collection
    match /attendanceEvents/{eventId} {
      // Read: Users can query their own events, admins can query all
      allow read: if true;

      // Write: Anyone recording valid IN/OUT event or admin deleting
      allow create: if request.resource.data.action in ['IN', 'OUT'];
      allow update: if false; // Events are immutable
      allow delete: if true; // Admin deletion
    }
  }
}
