rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Attendance events collection
    match /attendanceEvents/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.action in ['IN', 'OUT'];
      allow update: if false;
      allow delete: if true;
    }

    // Attendance sessions collection (active and completed IN-to-OUT sessions)
    match /attendanceSessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['INSIDE', 'OUTSIDE'];
      allow update: if true;
      allow delete: if true;

      // Subcollection for chronological GPS location points
      match /locations/{locationId} {
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if true;
      }
    }

    // Geofence settings collection (Library attendance location & allowed radius)
    match /geofenceSettings/{settingId} {
      allow read: if true;
      allow write: if (isSignedIn() || request.auth == null)
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.radiusMeters is number
        && request.resource.data.radiusMeters >= 10
        && request.resource.data.enabled is bool;
    }

    // Notifications collection (Admin broadcasts, personal alerts, and system events)
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if (isSignedIn() || request.auth == null)
        && request.resource.data.title is string
        && request.resource.data.message is string;
      allow update: if (isSignedIn() || request.auth == null);
      allow delete: if (isSignedIn() || request.auth == null);
    }

    // Membership periods collection
    match /membershipPeriods/{periodId} {
      allow read: if true;
      allow write: if (isSignedIn() || request.auth == null);
    }

    // Pending geofence dwell entries (Persistent 1-minute return-IN countdown)
    match /pendingGeofenceEntries/{studentId} {
      allow read: if true;
      allow write: if (isSignedIn() || request.auth == null);
    }

    // Attendance dwell states for native Android and Web persistent tracking
    match /attendanceDwellStates/{studentId} {
      allow read: if true;
      allow write: if (isSignedIn() || request.auth == null);
    }
  }
}

