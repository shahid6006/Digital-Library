rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if true;
      allow write: if isSignedIn() || request.auth == null;
    }

    // Attendance events collection
    match /attendanceEvents/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.action in ['IN', 'OUT'];
      allow update: if false;
      allow delete: if true;
    }

    // Attendance sessions collection (active and completed IN-to-OUT sessions)
    match /attendanceSessions/{sessionId} {
      allow read: if true;
      allow create: if request.resource.data.status in ['INSIDE', 'OUTSIDE'];
      allow update: if true;
      allow delete: if true;

      // Subcollection for chronological GPS location points
      match /locations/{locationId} {
        allow read: if true;
        allow create: if true;
        allow update: if false;
        allow delete: if true;
      }
    }
  }
}
