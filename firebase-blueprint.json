{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Registered library student account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "fullName": { "type": "string", "maxLength": 200 },
        "normalizedName": { "type": "string", "maxLength": 200 },
        "authEmail": { "type": "string", "maxLength": 254 },
        "authUid": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "fullName", "normalizedName", "active", "createdAt"]
    },
    "AttendanceEvent": {
      "title": "AttendanceEvent",
      "description": "Library entry or exit event with GPS location coordinates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "enum": ["IN", "OUT"] },
        "timestamp": { "type": "string" },
        "dateKey": { "type": "string", "maxLength": 10 },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "accuracy": { "type": "number" }
          }
        },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "action", "timestamp", "dateKey", "createdAt"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "An active or completed IN-to-OUT library attendance session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 200 },
        "dateKey": { "type": "string", "maxLength": 10 },
        "inTimestamp": { "type": "string" },
        "outTimestamp": { "type": "string" },
        "inLocation": { "type": "object" },
        "outLocation": { "type": "object" },
        "lastLocation": { "type": "object" },
        "status": { "type": "string", "enum": ["INSIDE", "OUTSIDE"] },
        "totalMinutesInside": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "dateKey", "inTimestamp", "status", "createdAt"]
    },
    "SessionLocationPoint": {
      "title": "SessionLocationPoint",
      "description": "A timestamped GPS coordinate recorded during an active IN session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "studentId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy": { "type": "number" },
        "timestamp": { "type": "string" },
        "sequenceNumber": { "type": "number" }
      },
      "required": ["id", "sessionId", "studentId", "latitude", "longitude", "timestamp", "sequenceNumber"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of all registered student profiles"
    },
    "/attendanceEvents/{eventId}": {
      "schema": "AttendanceEvent",
      "description": "Collection of chronological attendance IN and OUT events with geo-location"
    },
    "/attendanceSessions/{sessionId}": {
      "schema": "AttendanceSession",
      "description": "Collection of active and completed IN-to-OUT attendance sessions"
    },
    "/attendanceSessions/{sessionId}/locations/{locationId}": {
      "schema": "SessionLocationPoint",
      "description": "Ordered GPS location track points for an attendance session"
    }
  }
}
