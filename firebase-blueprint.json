{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Registered library student account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "fullName": { "type": "string", "maxLength": 200 },
        "normalizedName": { "type": "string", "maxLength": 200 },
        "authEmail": { "type": "string", "maxLength": 254 },
        "authUid": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "dateOfJoining": { "type": "string" }
      },
      "required": ["id", "firstName", "lastName", "fullName", "normalizedName", "active", "createdAt"]
    },
    "AttendanceEvent": {
      "title": "AttendanceEvent",
      "description": "Library entry or exit event with GPS location coordinates and geofence tracking metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 200 },
        "action": { "type": "string", "enum": ["IN", "OUT"] },
        "triggerType": { "type": "string", "enum": ["MANUAL", "GEOFENCE_AUTO"] },
        "timestamp": { "type": "string" },
        "dateKey": { "type": "string", "maxLength": 10 },
        "location": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "accuracy": { "type": "number" }
          }
        },
        "geofenceId": { "type": "string" },
        "geofenceVersion": { "type": "string" },
        "dwellMinutes": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentId", "action", "timestamp", "dateKey", "createdAt"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "An active or completed IN-to-OUT library attendance session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 200 },
        "dateKey": { "type": "string", "maxLength": 10 },
        "inTimestamp": { "type": "string" },
        "outTimestamp": { "type": "string" },
        "inLocation": { "type": "object" },
        "outLocation": { "type": "object" },
        "lastLocation": { "type": "object" },
        "triggerType": { "type": "string", "enum": ["MANUAL", "GEOFENCE_AUTO"] },
        "geofenceVersion": { "type": "string" },
        "status": { "type": "string", "enum": ["INSIDE", "OUTSIDE"] },
        "totalMinutesInside": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "dateKey", "inTimestamp", "status", "createdAt"]
    },
    "SessionLocationPoint": {
      "title": "SessionLocationPoint",
      "description": "A timestamped GPS coordinate recorded during an active IN session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "studentId": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "accuracy": { "type": "number" },
        "timestamp": { "type": "string" },
        "sequenceNumber": { "type": "number" }
      },
      "required": ["id", "sessionId", "studentId", "latitude", "longitude", "timestamp", "sequenceNumber"]
    },
    "GeofenceSettings": {
      "title": "GeofenceSettings",
      "description": "Admin-configured library attendance location coordinates and allowable radius",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radiusMeters": { "type": "number" },
        "enabled": { "type": "boolean" },
        "version": { "type": "string" },
        "address": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["latitude", "longitude", "radiusMeters", "enabled", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Library announcement, alert, or system event notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientType": { "type": "string", "enum": ["ALL", "STUDENT", "ADMIN"] },
        "recipientStudentId": { "type": "string" },
        "recipientStudentName": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "category": { "type": "string", "enum": ["ATTENDANCE", "MEMBERSHIP", "STUDENTS", "SYSTEM"] },
        "priority": { "type": "string", "enum": ["normal", "important"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "dedupKey": { "type": "string" }
      },
      "required": ["id", "recipientType", "title", "message", "category", "priority", "read", "createdAt", "createdBy"]
    },
    "MembershipPeriod": {
      "title": "MembershipPeriod",
      "description": "Student monthly membership validity period",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "DUE", "EXPIRED", "RENEWED"] },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "studentId", "studentName", "startDate", "endDate", "status", "createdAt", "createdBy"]
    },
    "PendingGeofenceEntry": {
      "title": "PendingGeofenceEntry",
      "description": "Persistent pending-entry verification state for 1-minute geofence dwell",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "type": "string", "enum": ["WAITING_FOR_DWELL", "VERIFIED", "CANCELLED"] },
        "dwellStartTimestamp": { "type": "string" },
        "requiredDwellSeconds": { "type": "number" },
        "latestLatitude": { "type": "number" },
        "latestLongitude": { "type": "number" },
        "latestAccuracy": { "type": "number" },
        "lastLocationTimestamp": { "type": "string" },
        "geofenceId": { "type": "string" },
        "geofenceVersion": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "status", "dwellStartTimestamp", "requiredDwellSeconds", "createdAt", "updatedAt"]
    },
    "AttendanceDwellState": {
      "title": "AttendanceDwellState",
      "description": "Persistent 1-minute background dwell verification state for Android and Web",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "status": { "type": "string", "enum": ["WAITING_FOR_DWELL", "VERIFIED", "CANCELLED"] },
        "dwellStartTimestamp": { "type": "string" },
        "requiredDwellSeconds": { "type": "number" },
        "geofenceVersion": { "type": "string" },
        "enterLocation": {
          "type": "object",
          "properties": {
            "latitude": { "type": "number" },
            "longitude": { "type": "number" },
            "accuracy": { "type": "number" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["studentId", "status", "dwellStartTimestamp", "requiredDwellSeconds", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of all registered student profiles"
    },
    "/attendanceEvents/{eventId}": {
      "schema": "AttendanceEvent",
      "description": "Collection of chronological attendance IN and OUT events with geo-location"
    },
    "/attendanceSessions/{sessionId}": {
      "schema": "AttendanceSession",
      "description": "Collection of active and completed IN-to-OUT attendance sessions"
    },
    "/attendanceSessions/{sessionId}/locations/{locationId}": {
      "schema": "SessionLocationPoint",
      "description": "Ordered GPS location track points for an attendance session"
    },
    "/geofenceSettings/{settingId}": {
      "schema": "GeofenceSettings",
      "description": "Library official attendance location geofence configuration"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Broadcast, direct student notifications, and admin alerts"
    },
    "/membershipPeriods/{periodId}": {
      "schema": "MembershipPeriod",
      "description": "Historical and active student membership cycles"
    },
    "/pendingGeofenceEntries/{studentId}": {
      "schema": "PendingGeofenceEntry",
      "description": "Persistent 1-minute return-IN geofence dwell countdown state per student"
    },
    "/attendanceDwellStates/{studentId}": {
      "schema": "AttendanceDwellState",
      "description": "Persistent 1-minute background dwell verification state for Android and Web"
    }
  }
}
